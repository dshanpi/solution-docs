b'+otg_role_file="/sys/devices/platform/soc@3000000/10.usbc0/otg_role"'
b'+usb_device_file="/sys/devices/platform/soc@3000000/10.usbc0/usb_device"'
b' hardware_type=`cat /proc/cmdline | tr \' \' \'\\n\' | grep \'hardware\' | awk -F "=" \'{print $2}\'`'
b' '
b'+# T527 (sun55iw3p1) \xe4\xbd\xbf\xe7\x94\xa8 10.usbc0 \xe8\x8a\x82\xe7\x82\xb9'
b'+# \xe9\xbb\x98\xe8\xae\xa4\xe8\xb7\xaf\xe5\xbe\x84\xe5\xb7\xb2\xe7\xbb\x8f\xe8\xae\xbe\xe7\xbd\xae\xe4\xb8\xba T527 \xe7\x9a\x84\xe8\xb7\xaf\xe5\xbe\x84'
b'+'
b' function enable_udc(){'
b' \twhile [ 1 ];do'
b' \t\tudc=`ls /sys/class/udc 2>/dev/null`'
b'@@ -75,22 +78,14 @@ function start_adb(){'
b' '
b' case "$1" in'
b' \tstart|"")'
b'-\t\tif [ "x$hardware_type" = "xsun8iw11p1" ];then'
b'-\t\t\totg_role_file="/sys/devices/platform/soc@1c00000/soc@1c00000:usbc0@0/otg_role"'
b'-\t\telif [ "x$hardware_type" = "xsun8iw20p1" ];then'
b'-\t\t\totg_role_file="/sys/devices/platform/soc@3000000/soc@3000000:usbc0@0/otg_role"'
b'-\t\tfi'
b'+\t\t# \xe6\xa3\x80\xe6\x9f\xa5 OTG \xe8\xa7\x92\xe8\x89\xb2'
b' \t\t[ -f "$otg_role_file" ] && otg_role=`cat "$otg_role_file"`'
b' \t\techo "usb0 current mode: $otg_role"'
b'-\t\tif [ -f "$otg_role_file" ] && [ "x$otg_role" != "xusb_device" ];then'
b'-\t\t\t# force switch usb0 to device mode'
b'-\t\t\techo "Starting switch usb0 to device mode."'
b'-\t\t\tif [ "x$hardware_type" = "xsun8iw11p1" ];then'
b'-\t\t\t\tusb_device_file="/sys/devices/platform/soc@1c00000/soc@1c00000:usbc0@0/usb_device"'
b'-\t\t\telif [ "x$hardware_type" = "xsun8iw20p1" ];then'
b'-\t\t\t\tusb_device_file="/sys/devices/platform/soc@3000000/soc@3000000:usbc0@0/usb_device"'
b'-\t\t\tfi'
b'-\t\t\t[ -f "$usb_device_file" ] && cat $usb_device_file'
b'+'
b'+\t\t# \xe5\xa6\x82\xe6\x9e\x9c\xe5\xbd\x93\xe5\x89\x8d\xe4\xb8\x8d\xe6\x98\xaf device \xe6\xa8\xa1\xe5\xbc\x8f\xef\xbc\x8c\xe5\x88\x99\xe5\x88\x87\xe6\x8d\xa2'
b'+\t\tif [ -f "$usb_device_file" ] && [ "x$otg_role" != "xusb_device" ]; then'
b'+\t\t\techo "Switching USB to device mode..."'
b'+\t\t\tcat $usb_device_file'
b' \t\tfi'
b' \t\t[ -f $adb_serialnumber ] && serialnumber=`cat $adb_serialnumber`'
b' \t\tif [ "x$serialnumber" = "x" ];then'

