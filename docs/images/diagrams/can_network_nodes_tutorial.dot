digraph G {
  graph [rankdir=LR, bgcolor="white", margin=0.2, nodesep=0.38, ranksep=0.3, label="本教程中的 CAN 网络", labelloc="t", fontname="Noto Sans CJK SC", fontsize=17];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=13, color="#334155", margin="0.20,0.11"];
  edge [dir=both, color="#2563EB", fontcolor="#1E3A8A", fontname="Noto Sans CJK SC", fontsize=12, penwidth=2.0, arrowsize=0.75];

  board [label="节点 1：ESP32-C3 底板\n\nESP32-C3：处理 CAN 报文\nTJA1050：连接 CANH、CANL\n两者共同组成这一端的节点", fillcolor="#DBEAFE"];
  bus [label="共享的 CAN 总线\nCANH + CANL", shape=box, style="filled", fillcolor="#FEF3C7"];
  motor [label="节点 2：IG35EC020\n\n内部 CAN 接口和电机控制器\n接收命令并报告状态", fillcolor="#DCFCE7"];

  board -> bus [label="报文可以双向传输"];
  bus -> motor [label="报文可以双向传输"];
}
