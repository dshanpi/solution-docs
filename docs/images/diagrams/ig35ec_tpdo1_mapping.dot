digraph ig35ec_tpdo1_mapping {
    graph [
        bgcolor="white",
        rankdir=TB,
        pad="0.28",
        nodesep="0.25",
        ranksep="0.35"
    ];
    node [
        shape=box,
        style="rounded,filled",
        fontname="Noto Sans CJK SC",
        fontsize=14,
        margin="0.22,0.14",
        color="#334155",
        penwidth=1.3,
        width=6.2
    ];
    edge [
        fontname="Noto Sans CJK SC",
        fontsize=12,
        color="#64748b",
        fontcolor="#475569",
        penwidth=1.4,
        arrowsize=0.75
    ];

    comm [label="读取 0x1800:01\n返回 0x80000181", fillcolor="#dbeafe", color="#2563eb"];
    decode [label="bit 31 = 1：TPDO1 当前无效（禁用）\n低 11 位 = 0x181：配置的标准 CAN-ID", fillcolor="#fee2e2", color="#dc2626"];
    count [label="读取 0x1A00:00\n返回 2：共有两条映射", fillcolor="#f1f5f9"];
    map1 [label="0x1A00:01 = 0x60620020\n对象 0x6062:00，占 0x20 = 32 bit", fillcolor="#ecfccb", color="#65a30d"];
    map2 [label="0x1A00:02 = 0x60640020\n对象 0x6064:00，占 0x20 = 32 bit", fillcolor="#dcfce7", color="#16a34a"];
    layout [label="如果将来按规范启用并触发 TPDO1\nCAN-ID 0x181，DLC 8\nDATA[0..3] = 0x6062:00 的当前值\nDATA[4..7] = 0x6064:00 的当前值", fillcolor="#fef3c7", color="#d97706"];
    observed [label="本课保持只读，没有启用 TPDO1\n5 秒实测：Heartbeat 5 帧，0x181 为 0 帧", fillcolor="#f1f5f9"];

    comm -> decode -> count;
    count -> map1 -> map2 -> layout -> observed;
}
